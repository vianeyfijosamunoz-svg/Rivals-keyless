            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local head = char and char:FindFirstChild("Head")

            if ESPConfig.ChamsEnabled and char and hum and hum.Health > 0 then
                if not chamsCache[player] or not chamsCache[player].Highlight or not chamsCache[player].Highlight.Parent then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ApocalypseChams"
                    highlight.FillColor = ESPConfig.ChamsFillColor
                    highlight.OutlineColor = ESPConfig.ChamsOutlineColor
                    highlight.FillTransparency = ESPConfig.ChamsFillTransparency
                    highlight.OutlineTransparency = ESPConfig.ChamsOutlineTransparency
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = char
                    chamsCache[player] = {Highlight = highlight}
                else
                    local hl = chamsCache[player].Highlight
                    hl.FillColor = ESPConfig.ChamsFillColor
                    hl.OutlineColor = ESPConfig.ChamsOutlineColor
                    hl.FillTransparency = ESPConfig.ChamsFillTransparency
                    hl.OutlineTransparency = ESPConfig.ChamsOutlineTransparency
                end
            else
                if chamsCache[player] and chamsCache[player].Highlight then
                    pcall(function() chamsCache[player].Highlight:Destroy() end)
                    chamsCache[player] = nil
                end
            end

            local function hideAll()
                if visuals then
                    for k, d in pairs(visuals) do
                        if typeof(d) == "table" then
                            for _, line in pairs(d) do line.Visible = false end
                        else
                            d.Visible = false
                        end
                    end
                end
            end
            if not char or not hrp or not hum or hum.Health <= 0 then hideAll()
            else
                local isEnemy = true
                if ESPConfig.TeamCheck then
                    local myT, thrT = LocalPlayer:GetAttribute("TeamID"), player:GetAttribute("TeamID")
                    if myT ~= nil and thrT ~= nil then isEnemy = tostring(myT) ~= tostring(thrT)
                    elseif LocalPlayer.Team and player.Team then isEnemy = LocalPlayer.Team ~= player.Team end
                end
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local dist = myRoot and (myRoot.Position - hrp.Position).Magnitude or 0
                if not isEnemy or dist > ESPConfig.MaxDistance then hideAll()
                else
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if not onScreen then hideAll()
                    else
                        local size = Vector2.new(2000 / pos.Z, 3000 / pos.Z)
                        local boxPos = Vector2.new(pos.X - size.X / 2, pos.Y - size.Y / 2)
                        if ESPConfig.BoxEnabled then
                            visuals.Box.Visible = true
                            visuals.Box.Size = size
                            visuals.Box.Position = boxPos
                            visuals.Box.Outline = ESPConfig.BoxOutlineEnabled
                        else visuals.Box.Visible = false end
                        if ESPConfig.FilledBoxEnabled and ESPConfig.BoxEnabled then
                            visuals.BoxFill.Visible = true
                            visuals.BoxFill.Size = size
                            visuals.BoxFill.Position = boxPos
                        else visuals.BoxFill.Visible = false end
                        if ESPConfig.CornerBoxEnabled then
                            local c = visuals.Corner
                            local len = math.min(size.X, size.Y) * 0.25
                            c.TL1.Visible = true c.TL1.From = boxPos c.TL1.To = boxPos + Vector2.new(len, 0)
                            c.TL2.Visible = true c.TL2.From = boxPos c.TL2.To = boxPos + Vector2.new(0, len)
                            c.TR1.Visible = true c.TR1.From = boxPos + Vector2.new(size.X, 0) c.TR1.To = boxPos + Vector2.new(size.X - len, 0)
                            c.TR2.Visible = true c.TR2.From = boxPos + Vector2.new(size.X, 0) c.TR2.To = boxPos + Vector2.new(size.X, len)
                            c.BL1.Visible = true c.BL1.From = boxPos + Vector2.new(0, size.Y) c.BL1.To = boxPos + Vector2.new(len, size.Y)
                            c.BL2.Visible = true c.BL2.From = boxPos + Vector2.new(0, size.Y) c.BL2.To = boxPos + Vector2.new(0, size.Y - len)
                            c.BR1.Visible = true c.BR1.From = boxPos + Vector2.new(size.X, size.Y) c.BR1.To = boxPos + Vector2.new(size.X - len, size.Y)
                            c.BR2.Visible = true c.BR2.From = boxPos + Vector2.new(size.X, size.Y) c.BR2.To = boxPos + Vector2.new(size.X, size.Y - len)
                        else
                            for _, line in pairs(visuals.Corner) do line.Visible = false end
                        end
                        if ESPConfig.NameEnabled then
                            visuals.Name.Visible = true
                            visuals.Name.Text = StreamerModeEnabled and "Player" or player.Name
                            visuals.Name.Size = ESPConfig.TextSize
                            visuals.Name.Outline = ESPConfig.TextOutlineEnabled
                            visuals.Name.Position = Vector2.new(pos.X, boxPos.Y - ESPConfig.TextSize - 4)
                        else visuals.Name.Visible = false end
                        if ESPConfig.PingEnabled then
                            local ping = 0
                            pcall(function()
                                ping = math.floor(player:GetNetworkPing() * 1000)
                            end)
                            visuals.Ping.Visible = true
                            visuals.Ping.Text = ping .. " ms"
                            visuals.Ping.Size = ESPConfig.TextSize - 1
                            visuals.Ping.Outline = ESPConfig.TextOutlineEnabled
                            visuals.Ping.Position = Vector2.new(pos.X, boxPos.Y - ESPConfig.TextSize - 22)
                        else
                            visuals.Ping.Visible = false
                        end
                        if ESPConfig.FPSEnabled then
                            visuals.FPS.Visible = true
                            visuals.FPS.Text = "FPS: --"
                            visuals.FPS.Size = ESPConfig.TextSize - 1
                            visuals.FPS.Outline = ESPConfig.TextOutlineEnabled
                            visuals.FPS.Position = Vector2.new(pos.X, boxPos.Y - ESPConfig.TextSize - 38)
                        else
                            visuals.FPS.Visible = false
                        end
                        if ESPConfig.HealthBarEnabled and hum then
                            local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                            local barHeight = size.Y * healthPct
                            visuals.HealthBarBG.Visible = true
                            visuals.HealthBarBG.From = Vector2.new(boxPos.X - 6, boxPos.Y + size.Y)
                            visuals.HealthBarBG.To = Vector2.new(boxPos.X - 6, boxPos.Y)
                            visuals.HealthBar.Visible = true
                            visuals.HealthBar.From = Vector2.new(boxPos.X - 6, boxPos.Y + size.Y)
                            visuals.HealthBar.To = Vector2.new(boxPos.X - 6, boxPos.Y + size.Y - barHeight)
                            visuals.HealthBar.Color = Color3.fromHSV(healthPct * 0.3, 1, 1)
                        else
                            visuals.HealthBar.Visible = false
                            visuals.HealthBarBG.Visible = false
                        end
                        if ESPConfig.HealthTextEnabled and hum then
                            visuals.HealthText.Visible = true
                            visuals.HealthText.Size = ESPConfig.TextSize - 2
                            visuals.HealthText.Text = math.floor(hum.Health) .. "HP"
                            visuals.HealthText.Position = Vector2.new(boxPos.X - 22, boxPos.Y + (size.Y / 2))
                        else visuals.HealthText.Visible = false end
                        if ESPConfig.DistanceEnabled then
                            visuals.Distance.Visible = true
                            visuals.Distance.Size = ESPConfig.TextSize - 1
                            visuals.Distance.Text = math.floor(dist) .. " studs"
                            visuals.Distance.Position = Vector2.new(pos.X, boxPos.Y + size.Y + 2)
                        else visuals.Distance.Visible = false end
                        if ESPConfig.WeaponEnabled then
                            local tool = char:FindFirstChildOfClass("Tool")
                            local weaponName = tool and tool.Name or "None"
                            visuals.Weapon.Visible = true
                            visuals.Weapon.Text = weaponName
                            visuals.Weapon.Size = ESPConfig.TextSize - 1
                            visuals.Weapon.Outline = ESPConfig.TextOutlineEnabled
                            visuals.Weapon.Position = Vector2.new(pos.X, boxPos.Y + size.Y + 16)
                        else
                            visuals.Weapon.Visible = false
                        end
                        if ESPConfig.HeadDotEnabled and head then
                            local headPos, headOn = Camera:WorldToViewportPoint(head.Position)
                            if headOn then
                                visuals.HeadDot.Visible = true
                                visuals.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
                            else visuals.HeadDot.Visible = false end
                        else visuals.HeadDot.Visible = false end
                        if ESPConfig.TracersEnabled then
                            visuals.Tracer.Visible = true
                            visuals.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            visuals.Tracer.To = Vector2.new(pos.X, boxPos.Y + size.Y)
                        else visuals.Tracer.Visible = false end
                        if ESPConfig.ViewAngleEnabled and head then
                            local lookVector = head.CFrame.LookVector
                            local endPoint = head.Position + (lookVector * 5)
                            local p1, on1 = Camera:WorldToViewportPoint(head.Position)
                            local p2, on2 = Camera:WorldToViewportPoint(endPoint)
                            if on1 and on2 then
                                visuals.ViewAngle.Visible = true
                                visuals.ViewAngle.From = Vector2.new(p1.X, p1.Y)
                                visuals.ViewAngle.To = Vector2.new(p2.X, p2.Y)
                            else visuals.ViewAngle.Visible = false end
                        else visuals.ViewAngle.Visible = false end
                        if ESPConfig.SkeletonEnabled then
                            local function getPartPos(name)
                                local part = char:FindFirstChild(name)
                                if part then
                                    local p, on = Camera:WorldToViewportPoint(part.Position)
                                    return on and Vector2.new(p.X, p.Y) or nil
                                end
                                return nil
                            end
                            local headPos = getPartPos("Head")
                            local torsoPos = getPartPos("UpperTorso") or getPartPos("Torso")
                            local leftArm = getPartPos("LeftHand") or getPartPos("Left Arm")
                            local rightArm = getPartPos("RightHand") or getPartPos("Right Arm")
                            local leftLeg = getPartPos("LeftFoot") or getPartPos("Left Leg")
                            local rightLeg = getPartPos("RightFoot") or getPartPos("Right Leg")
                            if headPos and torsoPos then
                                visuals.Skeleton.Head.Visible = true
                                visuals.Skeleton.Head.From = headPos
                                visuals.Skeleton.Head.To = torsoPos
                            else visuals.Skeleton.Head.Visible = false end
                            if torsoPos and leftArm then
                                visuals.Skeleton.LeftArm.Visible = true
                                visuals.Skeleton.LeftArm.From = torsoPos
                                visuals.Skeleton.LeftArm.To = leftArm
                            else visuals.Skeleton.LeftArm.Visible = false end
                            if torsoPos and rightArm then
                                visuals.Skeleton.RightArm.Visible = true
                                visuals.Skeleton.RightArm.From = torsoPos
                                visuals.Skeleton.RightArm.To = rightArm
                            else visuals.Skeleton.RightArm.Visible = false end
                            if torsoPos and leftLeg then
                                visuals.Skeleton.LeftLeg.Visible = true
                                visuals.Skeleton.LeftLeg.From = torsoPos
                                visuals.Skeleton.LeftLeg.To = leftLeg
                            else visuals.Skeleton.LeftLeg.Visible = false end
                            if torsoPos and rightLeg then
                                visuals.Skeleton.RightLeg.Visible = true
                                visuals.Skeleton.RightLeg.From = torsoPos
                                visuals.Skeleton.RightLeg.To = rightLeg
                            else visuals.Skeleton.RightLeg.Visible = false end
                        else
                            for _, line in pairs(visuals.Skeleton) do line.Visible = false end
                        end
                    end
                end
            end
        end
    end

    if OrbitActive then
        local target = nil
        for _, p in ipairs(Players:GetPlayers()) do if isTargetValid(p) then target = p break end end
        if target and isTargetValid(target) then ManipulationText = "ORBITUS: " .. string.upper(target.Name) else ManipulationText = "ORBITUS: VOID" end
    elseif RagebotEnabled then
        local target = GetClosestTargetPlayer()
        if target and isTargetValid(target) then ManipulationText = "RAGEBOT: KILLING " .. string.upper(target.Name) else ManipulationText = "RAGEBOT: IDLE" end
    else
        ManipulationText = ""
    end
    ManipLabel.Text = ManipulationText
end)

