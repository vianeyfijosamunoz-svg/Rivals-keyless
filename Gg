local function UpdateRadar()
    if not RadarEnabled then
        RadarBG.Visible = false
        RadarBorder.Visible = false
        RadarCenter.Visible = false
        for _, dot in pairs(radarDots) do dot.Visible = false end
        return
    end
    local center = RadarPosition + Vector2.new(RadarSize / 2, RadarSize / 2)
    RadarBG.Position = center
    RadarBG.Radius = RadarSize / 2
    RadarBG.Visible = true
    RadarBorder.Position = center
    RadarBorder.Radius = RadarSize / 2
    RadarBorder.Visible = true
    RadarCenter.Position = center
    RadarCenter.Visible = true
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position
    local myLook = Camera.CFrame.LookVector
    local angle = math.atan2(myLook.X, myLook.Z)
    local idx = 1
    for _, plr in ipairs(Players:GetPlayers()) do
        if isTargetValid(plr) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local enemyPos = plr.Character.HumanoidRootPart.Position
            local delta = enemyPos - myPos
            local dist = delta.Magnitude
            if dist <= RadarRange then
                local relX = delta.X * math.cos(angle) - delta.Z * math.sin(angle)
                local relZ = delta.X * math.sin(angle) + delta.Z * math.cos(angle)
                local scale = (RadarSize / 2) / RadarRange
                local screenX = center.X + relX * scale
                local screenY = center.Y + relZ * scale
                if not radarDots[idx] then
                    radarDots[idx] = Drawing.new("Circle")
                    radarDots[idx].Filled = true
                    radarDots[idx].Radius = 4
                    radarDots[idx].ZIndex = 53
                end
                radarDots[idx].Position = Vector2.new(screenX, screenY)
                radarDots[idx].Color = Color3.fromRGB(255, 60, 60)
                radarDots[idx].Visible = true
                idx += 1
            end
        end
    end
    for i = idx, #radarDots do
        if radarDots[i] then radarDots[i].Visible = false end
    end
end

