local function SpawnDamageNumber(position, damage)
    if not DamageNumbersEnabled then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.StudsOffset = Vector3.new(math.random(-2, 2), 3, math.random(-2, 2))
    billboard.AlwaysOnTop = true
    billboard.Adornee = nil
    billboard.Parent = CoreGui
    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.Size = Vector3.new(0.1, 0.1, 0.1)
    part.Position = position
    part.Parent = Workspace
    billboard.Adornee = part
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "-" .. math.floor(damage)
    label.TextColor3 = Color3.fromRGB(255, 50, 50)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 22
    label.Parent = billboard
    table.insert(damageNumbers, {gui = billboard, part = part, start = tick()})
    task.delay(1.2, function()
        pcall(function()
            billboard:Destroy()
            part:Destroy()
        end)
    end)
end

local function CheckDamageNumbers()
    if not DamageNumbersEnabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local current = hum.Health
                local previous = lastHealth[player]
                if previous and current < previous and (previous - current) > 1 then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        SpawnDamageNumber(hrp.Position + Vector3.new(0, 2, 0), previous - current)
                    end
                end
                lastHealth[player] = current
            end
        end
    end
end

