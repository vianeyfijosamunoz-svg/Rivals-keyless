local function GetClosestPlayerAimbot()
    local closest = nil
    local shortestDistance = FOVRadius
    for _, player in pairs(Players:GetPlayers()) do
        if isTargetValid(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local head = player.Character:FindFirstChild("Head") or player.Character.HumanoidRootPart
            if AimbotWallCheck then local valid = getValidHead(player.Character) if not valid then continue end end
            local predicted = GetPredictedPosition(head)
            if ResolverEnabled then
                predicted = GetResolvedPosition(player, head)
            end
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
            local result = Workspace:Raycast(Camera.CFrame.Position, (predicted - Camera.CFrame.Position).Unit * 1000, params)
            if result == nil or result.Instance:IsDescendantOf(player.Character) then
                local pos, onScreen = Camera:WorldToViewportPoint(predicted)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                    if distance < shortestDistance then shortestDistance = distance closest = player end
                end
            end
        end
    end
    return closest
end

local function GetClosestTargetPlayer()
    local closest = nil
    local shortestDist = math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if isTargetValid(plr) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local dist = (myRoot.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = plr
                end
            end
        end
    end
    return closest
end

local function StartFreecam()
    if isFreecamActive then return end
    isFreecamActive = true
    originalCameraType = Camera.CameraType
    originalCameraSubject = Camera.CameraSubject
    Camera.CameraType = Enum.CameraType.Scriptable
    local camPos = Camera.CFrame.Position
    local camRot = Camera.CFrame
    freecamConn = RunService.RenderStepped:Connect(function(dt)
        if not isFreecamActive then return end
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + camRot.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - camRot.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - camRot.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + camRot.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move = move - Vector3.new(0, 1, 0) end
        if move.Magnitude > 0 then
            camPos = camPos + move.Unit * FreecamSpeed * dt
        end
        local mouseDelta = UserInputService:GetMouseDelta()
        local yaw = -mouseDelta.X * 0.003
        local pitch = -mouseDelta.Y * 0.003
        camRot = CFrame.new(camPos) * (camRot - camRot.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
        Camera.CFrame = camRot
    end)
end

local function StopFreecam()
    if not isFreecamActive then return end
    isFreecamActive = false
    if freecamConn then freecamConn:Disconnect() freecamConn = nil end
    Camera.CameraType = originalCameraType or Enum.CameraType.Custom
    if originalCameraSubject then Camera.CameraSubject = originalCameraSubject end
end

