RunService.RenderStepped:Connect(function(dt)
    tickCount = tickCount + 1

    if AimbotEnabled then
        local target = GetClosestPlayerAimbot()
        if target and isTargetValid(target) and target.Character then
            CurrentTarget = target
            local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if head then
                local predicted = GetPredictedPosition(head)
                if ResolverEnabled then
                    predicted = GetResolvedPosition(target, head)
                end
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, predicted)
            end
        end
    end

    if TriggerbotEnabled then
        local targetPlayer, targetRoot, targetHead = getClosestTriggerTarget()
        if targetPlayer and targetHead and targetRoot then
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                pcall(function()
                    local FighterController = require(LocalPlayer.PlayerScripts.Controllers.FighterController)
                    if FighterController and FighterController.LocalFighter then
                        local item = FighterController.LocalFighter.EquippedItem
                        if item then
                            local util = require(ReplicatedStorage.Modules.Utility)
                            local enum = require(ReplicatedStorage.Modules.EnumLibrary)

                            local aimCF = CFrame.lookAt(targetRoot.Position, targetHead.Position)
                            local targetCF = targetHead.CFrame
                            local randomOffset = Vector3.new(
                                (math.random() - 0.5) * 0.1,
                                (math.random() - 0.5) * 0.1,
                                (math.random() - 0.5) * 0.1
                            )
                            local aimedPos = targetHead.Position + randomOffset
                            local objSpaceHeadOffset = targetHead.CFrame:ToObjectSpace(CFrame.new(aimedPos))

                            local cameradata = {
                                [utf8.char(1)] = {
                                    [utf8.char(0)] = util:EncodeCFrame(aimCF),
                                    [utf8.char(1)] = util:EncodeCFrame(targetCF),
                                    [utf8.char(2)] = targetHead,
                                    [utf8.char(3)] = util:EncodeCFrame(objSpaceHeadOffset)
                                }
                            }

                            ReplicatedStorage.Remotes.Replication.Fighter.UseItem:FireServer(
                                item:Get("ObjectID"),
                                enum:ToEnum("StartShooting"),
                                cameradata,
                                nil
                            )
                        end
                    end
                end)
            end
        end
    end

    if OrbitActive then
        local targetPlayer, targetRoot, targetHead = getClosestTriggerTarget()
        if targetPlayer and targetRoot and targetHead and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local tChar = targetPlayer.Character
            local hrp = tChar.HumanoidRootPart
            local head = tChar:FindFirstChild("Head") or hrp
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local angle = (tickCount * (OrbitSpeed * 0.08)) * OrbitAngle
                local height = OrbitHeight + math.sin(tickCount * 0.12) * 1.8
                myRoot.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, height, OrbitStuds)
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
            end

            -- Desync integration
            local desyncCF = nil
            local desyncPos
            if hasKnifeViewModel(targetPlayer) then
                desyncPos = (targetRoot.CFrame * CFrame.new(0, 6, 0)).Position
            else
                desyncPos = (targetRoot.CFrame * CFrame.new(0, 1, 2)).Position
            end
            desyncCF = CFrame.lookAt(desyncPos, targetHead.Position)

            if desyncCF and LocalPlayer.Character then
                local myRootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRootPart then
                    local oldCF = myRootPart.CFrame
                    local oldVel = myRootPart.Velocity
                    local oldRotVel = myRootPart.RotVelocity
                    myRootPart.CFrame = desyncCF
                    RunService:BindToRenderStep("__restore", 101, function()
                        if myRootPart then
                            myRootPart.CFrame = oldCF
                            myRootPart.Velocity = oldVel
                            myRootPart.RotVelocity = oldRotVel
                        end
                        RunService:UnbindFromRenderStep("__restore")
                    end)
                end
            end

            -- Auto fire logic for Orbit
            pcall(function()
                local FighterController = require(LocalPlayer.PlayerScripts.Controllers.FighterController)
                local util = require(ReplicatedStorage.Modules.Utility)
                local enum = require(ReplicatedStorage.Modules.EnumLibrary)

                if FighterController and FighterController.LocalFighter then
                    local item = FighterController.LocalFighter.EquippedItem
                    if item and tick() - lastOrbitFire >= 0 then
                        lastOrbitFire = tick()
                        local aimCF = CFrame.lookAt(myRoot.Position, head.Position)
                        local targetCF = head.CFrame
                        local randomOffset = Vector3.new(
                            (math.random() - 0.5) * 0.1,
                            (math.random() - 0.5) * 0.1,
                            (math.random() - 0.5) * 0.1
                        )
                        local aimedPos = head.Position + randomOffset
                        local objSpaceHeadOffset = head.CFrame:ToObjectSpace(CFrame.new(aimedPos))
                        local cameradata = {}
                        cameradata[utf8.char(1)] = {
                            [utf8.char(0)] = util:EncodeCFrame(aimCF),
                            [utf8.char(1)] = util:EncodeCFrame(targetCF),
                            [utf8.char(2)] = head,
                            [utf8.char(3)] = util:EncodeCFrame(objSpaceHeadOffset)
                        }
                        ReplicatedStorage.Remotes.Replication.Fighter.UseItem:FireServer(
                            item:Get("ObjectID"),
                            enum:ToEnum("StartShooting"),
                            cameradata,
                            nil
                        )
                    end
                end
            end)
        else
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local spamOffset = Vector3.new(math.random(-8000000, 8000000), math.random(2000, 12000), math.random(-8000000, 8000000))
                LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(spamOffset) * CFrame.Angles(math.rad(tickCount * 420000), 0, 0)
            end
        end
    end

    if RagebotEnabled then
        updateDeflection()
        
        local target = GetClosestTargetPlayer()
        CurrentTarget = target
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if myRoot and target and isTargetValid(target) and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local tChar = target.Character
            local tHrp = tChar.HumanoidRootPart
            local optimalHitbox = tChar:FindFirstChild("Head") or tHrp

            local finalCF

            if RageMode == "GUN" then
                finalCF = tHrp.CFrame
            elseif RageMode == "MELE" then
                finalCF = tHrp.CFrame
            elseif RageMode == "KNIFE" then
                local side = math.sin(tick() * 6) * 3
                finalCF = tHrp.CFrame * CFrame.new(side, 0, 2.5)
            elseif RageMode == "BAITING SYSTEM" then
                local angle = tick() * 25000000
                finalCF = tHrp.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, 25000000)
            end

            if finalCF then
                local oldCF = myRoot.CFrame
                local oldVel = myRoot.AssemblyLinearVelocity
                local oldRotVel = myRoot.AssemblyAngularVelocity

                myRoot.CFrame = finalCF

                RunService:BindToRenderStep("__rage_restore", 101, function()
                    if myRoot and myRoot.Parent then
                        myRoot.CFrame = oldCF
                        myRoot.AssemblyLinearVelocity = oldVel
                        myRoot.AssemblyAngularVelocity = oldRotVel
                    end
                    RunService:UnbindFromRenderStep("__rage_restore")
                end)
            end

            if not deflecting[target] then
                pcall(function()
                    local FighterController = require(LocalPlayer.PlayerScripts.Controllers.FighterController)
                    local util = require(ReplicatedStorage.Modules.Utility)
                    local enum = require(ReplicatedStorage.Modules.EnumLibrary)

                    if FighterController and FighterController.LocalFighter then
                        local item = FighterController.LocalFighter.EquippedItem
                        if item and tick() - lastRageFire >= RageConfig.FireRate then
                            lastRageFire = tick()
                            if math.random(1, 100) <= RageConfig.Hitchance then
                                local aimCF = CFrame.lookAt(myRoot.Position, optimalHitbox.Position)
                                local targetCF = optimalHitbox.CFrame
                                local randomOffset = Vector3.new(
                                    (math.random() - 0.5) * 0.035,
                                    (math.random() - 0.5) * 0.035,
                                    (math.random() - 0.5) * 0.035
                                )
                                local aimedPos = optimalHitbox.Position + randomOffset
                                local objSpaceHeadOffset = optimalHitbox.CFrame:ToObjectSpace(CFrame.new(aimedPos))
                                local cameradata = {
                                    [utf8.char(1)] = {
                                        [utf8.char(0)] = util:EncodeCFrame(aimCF),
                                        [utf8.char(1)] = util:EncodeCFrame(targetCF),
                                        [utf8.char(2)] = optimalHitbox,
                                        [utf8.char(3)] = util:EncodeCFrame(objSpaceHeadOffset)
                                    }
                                }
                                local remote = ReplicatedStorage.Remotes.Replication.Fighter.UseItem
                                remote:FireServer(item:Get("ObjectID"), enum:ToEnum("StartShooting"), cameradata, nil)
                                remote:FireServer(item:Get("ObjectID"), enum:ToEnum("StartShooting"), cameradata, nil)
                            end
                        end
                    end
                end)
            end
        end
    end

    if getgenv().SpinbotEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(getgenv().SpinbotSpeed), 0)
    end

    if AntiAimEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local char = LocalPlayer.Character
        local hrp = char.HumanoidRootPart

        if AntiAimMode == "Broken (Recomendado)" then
            local speed = AntiAimSpinSpeed * 18
            local t = tick() * speed

            local randomOffset = Vector3.new(
                math.sin(t * 1.7) * 4,
                math.cos(t * 2.3) * 3.5,
                math.sin(t * 1.1) * 4
            )

            hrp.CFrame = CFrame.new(hrp.Position + randomOffset * 0.015) * CFrame.Angles(
                math.rad(math.sin(t) * 180),
                math.rad(t * 3),
                math.rad(math.cos(t * 1.4) * 180)
            )

            local head = char:FindFirstChild("Head")
            local upperTorso = char:FindFirstChild("UpperTorso")
            local lowerTorso = char:FindFirstChild("LowerTorso")

            if head and upperTorso and lowerTorso then
                head.CFrame = lowerTorso.CFrame * CFrame.new(0, -1.8, 0) * CFrame.Angles(math.rad(180), t * 2, 0)
            end

            local limbs = {
                "LeftUpperArm", "LeftLowerArm", "LeftHand",
                "RightUpperArm", "RightLowerArm", "RightHand",
                "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
                "RightUpperLeg", "RightLowerLeg", "RightFoot"
            }

            for i, limbName in ipairs(limbs) do
                local part = char:FindFirstChild(limbName)
                if part then
                    local chaos = t + i * 1.7
                    part.CFrame = hrp.CFrame * CFrame.new(
                        math.sin(chaos * 2.1) * 3.5,
                        math.cos(chaos * 1.8) * 3.2,
                        math.sin(chaos * 2.7) * 3.5
                    ) * CFrame.Angles(
                        math.rad(math.sin(chaos) * 360),
                        math.rad(math.cos(chaos * 1.3) * 360),
                        math.rad(math.sin(chaos * 0.9) * 360)
                    )
                end
            end
        else
            local yaw = AntiAimYaw
            local pitch = AntiAimPitch
            if AntiAimMode == "Spin" then
                yaw = (tickCount * AntiAimSpinSpeed) % 360
            elseif AntiAimMode == "Jitter" then
                yaw = AntiAimYaw + (math.random(-AntiAimJitter, AntiAimJitter))
            elseif AntiAimMode == "Down" then
                pitch = 89
            end
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(math.rad(pitch), math.rad(yaw), 0)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    if getgenv().HipHeightEnabled then
        hum.HipHeight = getgenv().HipHeightValue
    end
    if getgenv().CharTransparencyEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = getgenv().CharTransparencyValue
            elseif part:IsA("Decal") then
                part.Transparency = getgenv().CharTransparencyValue
            end
        end
    end
    if getgenv().NoCollisionEnabled or getgenv().NoclipEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    if getgenv().GravityEnabled then
        Workspace.Gravity = getgenv().GravityValue
    else
        Workspace.Gravity = defaultGravity
    end
    if getgenv().SpeedBoostEnabled then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(
                moveDir.X * getgenv().SpeedBoostValue,
                hrp.AssemblyLinearVelocity.Y,
                moveDir.Z * getgenv().SpeedBoostValue
            )
        end
    end
end)

